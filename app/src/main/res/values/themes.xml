<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TinyMeter" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="colorPrimaryVariant">@color/accent_amber_dim</item>
        <item name="colorOnPrimary">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Toggle buttons (metering mode) -->
    <style name="Widget.TinyMeter.ToggleButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="backgroundTint">@color/toggle_unselected_bg</item>
        <item name="rippleColor">@color/accent_amber_dim</item>
    </style>

    <!-- Mode buttons (Av / Tv / M) -->
    <style name="Widget.TinyMeter.ModeButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">@color/selector_mode_text</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="rippleColor">@color/accent_amber_dim</item>
    </style>

    <!-- Stepper +/- buttons -->
    <style name="Widget.TinyMeter.StepButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/step_button_bg</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="rippleColor">@color/accent_amber_dim</item>
    </style>

    <!-- Quick preset buttons -->
    <style name="Widget.TinyMeter.PresetButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/preset_button_text</item>
        <item name="android:paddingLeft">5dp</item>
        <item name="android:paddingRight">5dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="backgroundTint">@color/preset_button_bg</item>
        <item name="cornerRadius">4dp</item>
        <item name="rippleColor">@color/accent_amber_dim</item>
        <item name="android:layout_marginStart">3dp</item>
    </style>

</resources>
